<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SantéMap Algérie - صحة ماب الجزائر</title>
    
    <!-- Meta tags pour PWA Mobile (iOS & Android) -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#0d9488">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Police Google Cairo & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <!-- FontAwesome (CDN Cloudflare) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Leaflet.js -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

    <!-- EmailJS SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

    <style>
        body { font-family: 'Inter', 'Cairo', sans-serif; -webkit-tap-highlight-color: transparent; }
        html[dir="rtl"] { font-family: 'Cairo', 'Inter', sans-serif; }

        /* ================= ÉCRAN BLANC ET NOUVELLE ANIMATION ================= */
        #splash-screen {
            position: fixed;
            inset: 0;
            z-index: 99999;
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.8s;
        }

        .anim-santemap-logo {
            animation: logoCinematicZoom 3.5s cubic-bezier(0.35, 0, 0.25, 1) forwards;
            will-change: transform, opacity, filter;
        }

        @keyframes logoCinematicZoom {
            0% { opacity: 0; transform: scale(1.18); filter: blur(6px); }
            22% { opacity: 1; transform: scale(0.92); filter: blur(0px); }
            40% { opacity: 1; transform: scale(0.98); filter: blur(0px); }
            78% { opacity: 1; transform: scale(3.8); filter: blur(3px); }
            100% { opacity: 0; transform: scale(7.8); filter: blur(28px); visibility: hidden; }
        }

        #map-container {
            width: 100%;
            height: 600px;
            min-height: 600px;
            border-radius: 1rem;
            overflow: hidden;
            background-color: #f1f5f9;
            position: relative;
        }
        #leaflet-map { width: 100% !important; height: 100% !important; z-index: 10; }
        #gmap-iframe { width: 100% !important; height: 100% !important; border: 0; }
        .pulse-badge { animation: pulse-ring 2s infinite; }
        @keyframes pulse-ring {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }
        .leaflet-popup-content-wrapper { border-radius: 12px; padding: 4px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2); }
    </style>
</head>
<body class="bg-slate-50 text-gray-800 flex flex-col min-h-screen">

    <!-- ÉCRAN DE LANCEMENT BLANC (LOGO CROISSANT SANTÉMAP) -->
    <div id="splash-screen">
        <div class="anim-santemap-logo flex flex-col items-center justify-center text-center p-6 select-none">
            <div class="w-28 h-28 sm:w-32 sm:h-32 drop-shadow-2xl mb-4">
                <svg viewBox="0 0 100 100" class="w-full h-full">
                    <defs>
                        <linearGradient id="splashTealGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#14b8a6"/>
                            <stop offset="50%" stop-color="#0d9488"/>
                            <stop offset="100%" stop-color="#047857"/>
                        </linearGradient>
                    </defs>
                    <rect width="100" height="100" rx="22" fill="url(#splashTealGrad)"/>
                    <path d="M 27 41 L 27 65 A 9 9 0 0 0 36 74 L 54 74" fill="none" stroke="#FFFFFF" stroke-width="5.5" stroke-linecap="round"/>
                    <path d="M 42 27 L 62 27 A 8 8 0 0 1 70 35 L 70 54 A 4 4 0 0 1 68.8 56.8 L 59.8 65.8 A 4 4 0 0 1 57 67 L 42 67 A 8 8 0 0 1 34 59 L 34 35 A 8 8 0 0 1 42 27 Z" fill="#FFFFFF"/>
                    <path d="M 61.86 37.8 A 13.5 13.5 0 1 0 61.86 56.2 A 11.2 11.2 0 0 1 61.86 37.8 Z" fill="url(#splashTealGrad)"/>
                </svg>
            </div>
            <div>
                <span class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight">Santé<span class="text-teal-600">Map</span></span>
                <span class="block text-xs sm:text-sm font-bold text-teal-700 uppercase tracking-[0.3em] mt-1.5">Algérie</span>
            </div>
        </div>
    </div>

    <!-- 1. BANDEAU D'URGENCE (TRILINGUE) -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span>
                <span data-i18n="top_network" class="font-medium text-slate-200">Réseau Sanitaire National • 58 Wilayas</span>
            </div>
            <div class="flex items-center flex-wrap gap-4 text-[11px]">
                <a href="tel:14" class="hover:text-white transition"><i class="fa-solid fa-fire-extinguisher text-red-400 mx-1"></i> <span data-i18n="emergency_pc">Protection Civile</span> : <strong class="text-white">14</strong></a>
                <a href="tel:1021" class="hover:text-white transition"><i class="fa-solid fa-truck-medical text-amber-400 mx-1"></i> <span data-i18n="emergency_samu">SAMU</span> : <strong class="text-white">1021</strong></a>
                <a href="tel:1548" class="hover:text-white transition"><i class="fa-solid fa-shield-halved text-blue-400 mx-1"></i> <span data-i18n="emergency_police">Police</span> : <strong class="text-white">1548</strong></a>
                <a href="tel:1055" class="hover:text-white transition"><i class="fa-solid fa-person-military-pointing text-teal-400 mx-1"></i> <span data-i18n="emergency_gendarmerie">Gendarmerie</span> : <strong class="text-white">1055</strong></a>
            </div>
        </div>
    </div>

    <!-- 2. NAVIGATION (AVEC BOUTON TÉLÉCHARGER L'APPLICATION) -->
    <header class="bg-white border-b shadow-sm sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3 rtl:space-x-reverse cursor-pointer" onclick="closeDashboard(); resetAllFilters();">
                <div class="w-10 h-10 shadow-md rounded-xl overflow-hidden shrink-0">
                    <svg viewBox="0 0 100 100" class="w-full h-full">
                        <defs>
                            <linearGradient id="navTealGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#14b8a6"/>
                                <stop offset="50%" stop-color="#0d9488"/>
                                <stop offset="100%" stop-color="#047857"/>
                            </linearGradient>
                        </defs>
                        <rect width="100" height="100" rx="22" fill="url(#navTealGrad)"/>
                        <path d="M 27 41 L 27 65 A 9 9 0 0 0 36 74 L 54 74" fill="none" stroke="#FFFFFF" stroke-width="5.5" stroke-linecap="round"/>
                        <path d="M 42 27 L 62 27 A 8 8 0 0 1 70 35 L 70 54 A 4 4 0 0 1 68.8 56.8 L 59.8 65.8 A 4 4 0 0 1 57 67 L 42 67 A 8 8 0 0 1 34 59 L 34 35 A 8 8 0 0 1 42 27 Z" fill="#FFFFFF"/>
                        <path d="M 61.86 37.8 A 13.5 13.5 0 1 0 61.86 56.2 A 11.2 11.2 0 0 1 61.86 37.8 Z" fill="url(#navTealGrad)"/>
                    </svg>
                </div>
                <div>
                    <span class="text-xl font-extrabold text-gray-900 tracking-tight">Santé<span class="text-teal-600">Map</span></span>
                    <span data-i18n="brand_sub" class="block text-[10px] text-teal-700 font-bold uppercase tracking-wider">Algérie</span>
                </div>
            </div>
            
            <div class="flex items-center space-x-2 sm:space-x-3 rtl:space-x-reverse">
                <!-- SÉLECTEUR DE LANGUE -->
                <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-bold">
                    <button onclick="setLanguage('fr')" id="lang-btn-fr" class="px-2 py-1 rounded-lg transition">FR</button>
                    <button onclick="setLanguage('ar')" id="lang-btn-ar" class="px-2 py-1 rounded-lg transition">العربية</button>
                    <button onclick="setLanguage('en')" id="lang-btn-en" class="px-2 py-1 rounded-lg transition">EN</button>
                </div>

                <!-- NOUVEAU BOUTON : TÉLÉCHARGER L'APPLICATION MOBILE -->
                <button onclick="openModal('download-modal')" class="text-xs font-bold bg-slate-900 hover:bg-slate-800 text-white px-3 py-2 rounded-xl transition flex items-center gap-1.5 shadow-sm border border-slate-700">
                    <i class="fa-solid fa-mobile-screen-button text-teal-400 text-sm"></i>
                    <span class="hidden md:inline">Télécharger l'application</span>
                    <span class="md:hidden">App</span>
                </button>

                <!-- BOUTON ESPACE PRO / MON COMPTE -->
                <div id="auth-buttons-zone" class="flex items-center gap-2">
                    <button onclick="openModal('login-modal')" class="text-xs font-semibold text-slate-700 hover:bg-slate-100 px-3 py-2 rounded-xl border border-slate-200 transition hidden sm:inline-block">
                        Connexion
                    </button>
                    <button onclick="openModal('register-modal')" class="text-xs font-semibold bg-teal-600 hover:bg-teal-700 text-white px-3 py-2 rounded-xl transition shadow-sm flex items-center gap-1.5 whitespace-nowrap">
                        <i class="fa-solid fa-user-doctor"></i>
                        <span class="hidden sm:inline">+ Inscrire un Cabinet</span>
                        <span class="sm:hidden">+ Inscrire</span>
                    </button>
                </div>

                <div id="logged-user-zone" class="hidden flex items-center gap-2">
                    <button onclick="openDashboard()" class="text-xs font-bold bg-teal-50 text-teal-800 border border-teal-200 px-3 py-2 rounded-xl hover:bg-teal-100 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-user text-teal-600 text-base"></i>
                        <span id="nav-user-name">Mon Compte</span>
                    </button>
                    <button onclick="logoutUser()" title="Se déconnecter" class="text-slate-400 hover:text-red-600 p-2 text-sm">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- ======================================================== -->
    <!-- MODAL : TÉLÉCHARGER L'APPLICATION SANTÉMAP (ANDROID/IOS) -->
    <!-- ======================================================== -->
    <div id="download-modal" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-gray-100 text-start animate-fade-in relative">
            <button onclick="closeModal('download-modal')" class="absolute top-5 right-5 text-gray-400 hover:text-gray-600 text-2xl font-bold">
                &times;
            </button>

            <div class="flex items-center space-x-3 mb-4">
                <div class="w-12 h-12 shadow-md rounded-2xl overflow-hidden shrink-0">
                    <svg viewBox="0 0 100 100" class="w-full h-full">
                        <rect width="100" height="100" rx="22" fill="#0d9488"/>
                        <path d="M 27 41 L 27 65 A 9 9 0 0 0 36 74 L 54 74" fill="none" stroke="#FFFFFF" stroke-width="5.5" stroke-linecap="round"/>
                        <path d="M 42 27 L 62 27 A 8 8 0 0 1 70 35 L 70 54 A 4 4 0 0 1 68.8 56.8 L 59.8 65.8 A 4 4 0 0 1 57 67 L 42 67 A 8 8 0 0 1 34 59 L 34 35 A 8 8 0 0 1 42 27 Z" fill="#FFFFFF"/>
                        <path d="M 61.86 37.8 A 13.5 13.5 0 1 0 61.86 56.2 A 11.2 11.2 0 0 1 61.86 37.8 Z" fill="#0d9488"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-xl font-black text-gray-900">Application SantéMap Algérie</h3>
                    <p class="text-xs text-gray-500">Disponible sur Android & iOS (iPhone / iPad)</p>
                </div>
            </div>

            <p class="text-xs text-gray-600 leading-relaxed mb-6">
                Accédez à l'annuaire des médecins et pharmacies de garde directement depuis votre écran d'accueil, avec géolocalisation GPS en direct et sans connexion lente.
            </p>

            <div class="space-y-3">
                <!-- Option 1 : Installation PWA Instantanée (Fonctionne sur tous les mobiles) -->
                <button onclick="triggerPWAInstall()" class="w-full p-4 rounded-2xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs flex items-center justify-between transition shadow-md group">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-bolt-lightning text-amber-300 text-xl"></i>
                        <div class="text-left">
                            <span class="block font-extrabold text-sm">Installer l'application sur cet appareil</span>
                            <span class="text-[11px] text-teal-100 font-normal">Installation instantanée sans passer par les stores</span>
                        </div>
                    </div>
                    <i class="fa-solid fa-arrow-down-to-bracket text-base group-hover:translate-y-0.5 transition"></i>
                </button>

                <!-- Option 2 : Android APK -->
                <div class="p-3.5 rounded-2xl border border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <i class="fa-brands fa-android text-emerald-600 text-2xl"></i>
                        <div>
                            <span class="text-xs font-bold text-gray-800 block">Version Android (APK / Play Store)</span>
                            <span class="text-[10px] text-gray-500">Compatible Samsung, Xiaomi, Oppo, Realme...</span>
                        </div>
                    </div>
                    <button onclick="alert('Pour compiler le fichier .APK final prêt à distribuer, suivez le guide Capacitor fourni sous le code !');" class="bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-bold px-3 py-1.5 rounded-xl transition">
                        Fichier APK
                    </button>
                </div>

                <!-- Option 3 : Apple iOS -->
                <div class="p-3.5 rounded-2xl border border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <i class="fa-brands fa-apple text-slate-800 text-2xl"></i>
                        <div>
                            <span class="text-xs font-bold text-gray-800 block">Version iOS (iPhone & iPad)</span>
                            <span class="text-[10px] text-gray-500">Sur Safari : Partager ⎋ > Sur l'écran d'accueil</span>
                        </div>
                    </div>
                    <button onclick="alert('Sur Safari iPhone : Cliquez sur le bouton Partager (carré avec flèche vers le haut), puis faites défiler et touchez Sur l’écran d’accueil !');" class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-[11px] font-bold px-3 py-1.5 rounded-xl transition">
                        Guide iPhone
                    </button>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t text-center">
                <span class="text-[11px] text-gray-400 font-medium">Application certifiée 100% sécurisée • Réseau Santé Algérie</span>
            </div>
        </div>
    </div>

    <!-- 3. TABLEAU DE BORD PERSONNEL DU PRATICIEN -->
    <div id="dashboard-section" class="hidden max-w-5xl mx-auto px-4 py-8 w-full flex-1 animate-fade-in">
        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden mb-6">
            <div class="bg-gradient-to-r from-teal-800 to-slate-900 p-6 sm:p-8 text-white flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div class="flex items-center space-x-4 rtl:space-x-reverse">
                    <div class="w-16 h-16 bg-white/10 backdrop-blur rounded-2xl flex items-center justify-center text-teal-300 text-2xl border border-white/20">
                        <i class="fa-solid fa-user-doctor"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-2xl font-black" id="dash-header-name">Dr. Mansouri</h2>
                            <span class="text-[11px] bg-teal-500/30 text-teal-200 border border-teal-400/30 px-2 py-0.5 rounded-full font-bold">Compte Vérifié</span>
                        </div>
                        <p class="text-xs text-teal-200 mt-1" id="dash-header-sub">Cabinet Médical</p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button onclick="viewMyPracticeOnMap()" class="bg-white text-teal-900 font-bold px-4 py-2.5 rounded-xl text-xs hover:bg-teal-50 transition shadow-sm flex items-center gap-1.5">
                        <i class="fa-solid fa-map-location-dot text-teal-600"></i> Voir ma fiche sur la carte
                    </button>
                    <button onclick="logoutUser()" class="bg-red-500/20 text-red-200 hover:bg-red-500/30 border border-red-400/30 px-3 py-2.5 rounded-xl text-xs font-semibold transition">
                        Déconnexion
                    </button>
                </div>
            </div>

            <div class="p-6 sm:p-8">
                <div class="flex justify-between items-center pb-4 border-b mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900">Gestion de ma fiche publique</h3>
                        <p class="text-xs text-gray-500">Mettez à jour vos coordonnées et informez les patients en direct.</p>
                    </div>
                    <span id="save-indicator" class="text-xs text-emerald-600 font-bold hidden flex items-center gap-1">
                        <i class="fa-solid fa-check"></i> Données enregistrées !
                    </span>
                </div>

                <form onsubmit="handleUpdateMyData(event)" class="space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-slate-50 p-4 rounded-2xl border border-slate-200">
                        <label class="flex items-center gap-3 p-3 bg-white rounded-xl border border-slate-200 cursor-pointer hover:border-teal-400 transition">
                            <input type="checkbox" id="dash-garde" class="w-5 h-5 rounded text-teal-600 focus:ring-teal-500">
                            <div>
                                <span class="text-xs font-bold text-gray-800 block">🌙 Assurer la garde (Nuit & Week-end)</span>
                                <span class="text-[11px] text-gray-400">Votre fiche clignotera en vert sur la carte nationale</span>
                            </div>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-white rounded-xl border border-slate-200 cursor-pointer hover:border-teal-400 transition">
                            <input type="checkbox" id="dash-chifa" class="w-5 h-5 rounded text-teal-600 focus:ring-teal-500">
                            <div>
                                <span class="text-xs font-bold text-gray-800 block">💳 Conventionné Carte Chifa</span>
                                <span class="text-[11px] text-gray-400">Remboursement CNAS / CASNOS disponible</span>
                            </div>
                        </label>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Nom / Enseigne</label>
                            <input type="text" id="dash-name" required class="w-full border rounded-xl p-2.5 text-xs outline-none focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Spécialité / Titre</label>
                            <input type="text" id="dash-spec" required class="w-full border rounded-xl p-2.5 text-xs outline-none focus:ring-2 focus:ring-teal-500">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Wilaya</label>
                            <select id="dash-wilaya" required class="w-full border rounded-xl p-2.5 text-xs bg-white outline-none focus:ring-2 focus:ring-teal-500"></select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Téléphone</label>
                            <input type="tel" id="dash-tel" required class="w-full border rounded-xl p-2.5 text-xs outline-none focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">WhatsApp</label>
                            <input type="tel" id="dash-whatsapp" class="w-full border rounded-xl p-2.5 text-xs outline-none focus:ring-2 focus:ring-teal-500">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Adresse complète</label>
                            <input type="text" id="dash-addr" required class="w-full border rounded-xl p-2.5 text-xs outline-none focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">Horaires de travail</label>
                            <input type="text" id="dash-horaires" class="w-full border rounded-xl p-2.5 text-xs outline-none focus:ring-2 focus:ring-teal-500">
                        </div>
                    </div>

                    <div class="pt-4 flex justify-end gap-3">
                        <button type="button" onclick="closeDashboard()" class="px-5 py-2.5 rounded-xl border text-xs font-semibold hover:bg-slate-100 transition">
                            Fermer
                        </button>
                        <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white font-bold px-6 py-2.5 rounded-xl text-xs transition shadow-md flex items-center gap-1.5">
                            <i class="fa-solid fa-floppy-disk"></i> Enregistrer les modifications
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 4. CONTENU PRINCIPAL PUBLIC (RECHERCHE & CARTE) -->
    <div id="public-main-content">
        <section class="bg-gradient-to-r from-teal-800 via-teal-900 to-slate-900 text-white py-8 px-4 shadow-inner">
            <div class="max-w-7xl mx-auto">
                <div class="mb-4">
                    <h1 data-i18n="hero_title" class="text-2xl sm:text-3xl font-extrabold tracking-tight">
                        Trouvez un médecin ou une pharmacie en Algérie
                    </h1>
                    <p data-i18n="hero_desc" class="text-teal-200 text-xs sm:text-sm mt-1">
                        Sélectionnez votre Wilaya, repérez les officines de garde de nuit et lancez votre itinéraire direct.
                    </p>
                </div>

                <div class="bg-white p-2.5 rounded-2xl shadow-xl flex flex-col md:flex-row gap-2 text-gray-800">
                    <div class="flex-1 flex items-center px-3 border-b md:border-b-0 md:border-r rtl:md:border-r-0 rtl:md:border-l border-gray-200">
                        <i class="fa-solid fa-magnifying-glass text-teal-600 mx-2 text-sm"></i>
                        <input id="search-input" oninput="applyFilters()" type="text" 
                               data-i18n-ph="search_placeholder"
                               placeholder="Nom du praticien, clinique, spécialité..." 
                               class="w-full text-sm py-2 focus:outline-none bg-transparent">
