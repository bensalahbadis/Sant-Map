            { code: "58", fr: "58 - El Meniaa", ar: "58 - المنيعة", en: "58 - El Meniaa", lat: 30.5833, lng: 2.8833 }
        ];

        let currentLang = localStorage.getItem('santemap_lang') || 'fr';
        let currentMapEngine = 'gmap';
        let activeType = 'all';
        let filterGarde = false;
        let filterChifa = false;
        let leafletMap = null;
        let leafletMarkersGroup = null;

        function updateAuthUI() {
            const authZone = document.getElementById('auth-buttons-zone');
            const userZone = document.getElementById('logged-user-zone');
            const userNameSpan = document.getElementById('nav-user-name');
            if (loggedUser) {
                authZone.classList.add('hidden');
                userZone.classList.remove('hidden');
                userNameSpan.innerText = loggedUser.name;
            } else {
                authZone.classList.remove('hidden');
                userZone.classList.add('hidden');
            }
        }

        function openDashboard() {
            if (!loggedUser) return;
            document.getElementById('public-main-content').classList.add('hidden');
            document.getElementById('dashboard-section').classList.remove('hidden');
            document.getElementById('dash-header-name').innerText = loggedUser.name;
            document.getElementById('dash-header-sub').innerText = `${loggedUser.specialite} • ${loggedUser.adresse}`;
            document.getElementById('dash-name').value = loggedUser.name;
            document.getElementById('dash-spec').value = loggedUser.specialite;
            document.getElementById('dash-wilaya').value = loggedUser.wilaya;
            document.getElementById('dash-tel').value = loggedUser.tel;
            document.getElementById('dash-whatsapp').value = loggedUser.whatsapp || '';
            document.getElementById('dash-addr').value = loggedUser.adresse;
            document.getElementById('dash-horaires').value = loggedUser.horaires || '';
            document.getElementById('dash-garde').checked = !!loggedUser.garde;
            document.getElementById('dash-chifa').checked = !!loggedUser.chifa;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function closeDashboard() {
            document.getElementById('dashboard-section').classList.add('hidden');
            document.getElementById('public-main-content').classList.remove('hidden');
            if (leafletMap) setTimeout(() => leafletMap.invalidateSize(), 200);
        }

        function handleUpdateMyData(e) {
            e.preventDefault();
            if (!loggedUser) return;
            loggedUser.name = document.getElementById('dash-name').value;
            loggedUser.specialite = document.getElementById('dash-spec').value;
            loggedUser.wilaya = document.getElementById('dash-wilaya').value;
            loggedUser.tel = document.getElementById('dash-tel').value;
            loggedUser.whatsapp = document.getElementById('dash-whatsapp').value;
            loggedUser.adresse = document.getElementById('dash-addr').value;
            loggedUser.horaires = document.getElementById('dash-horaires').value;
            loggedUser.garde = document.getElementById('dash-garde').checked;
            loggedUser.chifa = document.getElementById('dash-chifa').checked;

            const index = practitioners.findIndex(p => p.id === loggedUser.id);
            if (index !== -1) practitioners[index] = { ...loggedUser };
            else practitioners.unshift(loggedUser);

            localStorage.setItem('santemap_final_db', JSON.stringify(practitioners));
            localStorage.setItem('santemap_logged_user', JSON.stringify(loggedUser));

            updateAuthUI();
            applyFilters();

            const ind = document.getElementById('save-indicator');
            ind.classList.remove('hidden');
            setTimeout(() => ind.classList.add('hidden'), 3000);
        }

        function viewMyPracticeOnMap() {
            closeDashboard();
            if (loggedUser) {
                document.getElementById('wilaya-select').value = loggedUser.wilaya;
                onWilayaChange();
                if (currentMapEngine === 'gmap') {
                    updateGmapView(loggedUser.lat, loggedUser.lng, loggedUser.name);
                } else if (leafletMap) {
                    leafletMap.flyTo([loggedUser.lat, loggedUser.lng], 16);
                }
            }
        }

        function handleUserLogin(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value.trim().toLowerCase();
            const pass = document.getElementById('login-password').value;
            const found = practitioners.find(p => p.email && p.email.toLowerCase() === email && p.password === pass);

            if (found) {
                loggedUser = found;
                localStorage.setItem('santemap_logged_user', JSON.stringify(loggedUser));
                closeModal('login-modal');
                updateAuthUI();
                openDashboard();
            } else {
                alert("Identifiants incorrects.");
            }
        }

        function logoutUser() {
            loggedUser = null;
            localStorage.removeItem('santemap_logged_user');
            updateAuthUI();
            closeDashboard();
        }

        function handleNewPractitioner(e) {
            e.preventDefault();
            const wCode = document.getElementById('new-wilaya').value;
            const wInfo = wilayas58.find(w => w.code === wCode);

            const newDoc = {
                id: Date.now(),
                name: document.getElementById('new-name').value,
                email: document.getElementById('new-email').value,
                password: document.getElementById('new-password').value,
                type: document.getElementById('new-type').value,
                specialite: document.getElementById('new-specialite').value,
                wilaya: wCode,
                adresse: document.getElementById('new-adresse').value,
                tel: document.getElementById('new-tel').value,
                whatsapp: document.getElementById('new-whatsapp').value,
                horaires: "08h30 - 16h30",
                garde: document.getElementById('new-garde').checked,
                chifa: document.getElementById('new-chifa').checked,
                lat: wInfo.lat + (Math.random() - 0.5) * 0.02,
                lng: wInfo.lng + (Math.random() - 0.5) * 0.02
            };

            practitioners.unshift(newDoc);
            localStorage.setItem('santemap_final_db', JSON.stringify(practitioners));
            loggedUser = newDoc;
            localStorage.setItem('santemap_logged_user', JSON.stringify(loggedUser));

            closeModal('register-modal');
            e.target.reset();
            updateAuthUI();
            document.getElementById('wilaya-select').value = wCode;
            onWilayaChange();
            openDashboard();
        }

        function switchMapEngine(engine) {
            currentMapEngine = engine;
            const iframe = document.getElementById('gmap-iframe');
            const leafletDiv = document.getElementById('leaflet-map');
            const btnGmap = document.getElementById('btn-engine-gmap');
            const btnOsm = document.getElementById('btn-engine-osm');

            if (engine === 'gmap') {
                iframe.style.display = 'block';
                leafletDiv.style.display = 'none';
                btnGmap.className = "px-2.5 py-1 rounded-md text-[11px] font-bold bg-white text-teal-800 shadow-sm transition";
                btnOsm.className = "px-2.5 py-1 rounded-md text-[11px] font-medium text-gray-600 hover:text-gray-900 transition";
                updateGmapView();
            } else {
                iframe.style.display = 'none';
                leafletDiv.style.display = 'block';
                btnOsm.className = "px-2.5 py-1 rounded-md text-[11px] font-bold bg-white text-teal-800 shadow-sm transition";
                btnGmap.className = "px-2.5 py-1 rounded-md text-[11px] font-medium text-gray-600 hover:text-gray-900 transition";
                if (!leafletMap) initLeaflet();
                else leafletMap.invalidateSize();
            }
        }

        function updateGmapView(targetLat, targetLng, label) {
            const iframe = document.getElementById('gmap-iframe');
            let lat = targetLat;
            let lng = targetLng;

            if (!lat || !lng) {
                const wCode = document.getElementById('wilaya-select').value;
                const w = wilayas58.find(x => x.code === wCode);
                lat = w ? w.lat : 36.7538;
                lng = w ? w.lng : 3.0588;
            }

            const query = label ? encodeURIComponent(label + ", Algerie") : `${lat},${lng}`;
            iframe.src = `https://maps.google.com/maps?q=${query}&z=14&output=embed`;
        }

        function initLeaflet() {
            try {
                if (typeof L === 'undefined') return;
                const wCode = document.getElementById('wilaya-select').value;
                const w = wilayas58.find(x => x.code === wCode);

                leafletMap = L.map('leaflet-map').setView([w.lat, w.lng], 13);
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(leafletMap);
                leafletMarkersGroup = L.layerGroup().addTo(leafletMap);
                setTimeout(() => { leafletMap.invalidateSize(); }, 200);
            } catch(e) { console.warn(e); }
        }

        function applyFilters() {
            const list = document.getElementById('cards-container');
            const keyword = document.getElementById('search-input').value.toLowerCase().trim();
            const currentWilaya = document.getElementById('wilaya-select').value;

            list.innerHTML = '';
            if (leafletMarkersGroup) leafletMarkersGroup.clearLayers();

            const filtered = practitioners.filter(p => {
                const matchWilaya = (p.wilaya === currentWilaya);
                const matchType = (activeType === 'all') || (p.type === activeType);
                const matchGarde = !filterGarde || p.garde;
                const matchChifa = !filterChifa || p.chifa;
                const matchSearch = p.name.toLowerCase().includes(keyword) || p.specialite.toLowerCase().includes(keyword) || p.adresse.toLowerCase().includes(keyword);
                return matchWilaya && matchType && matchGarde && matchChifa && matchSearch;
            });

            document.getElementById('results-count').innerText = `${filtered.length} résultat(s)`;
            document.getElementById('total-badge').innerText = filtered.length;

            if (filtered.length === 0) {
                list.innerHTML = `<div class="text-center py-12 bg-white rounded-2xl border border-dashed border-gray-300 p-6"><p class="text-sm font-semibold text-gray-600">Aucun résultat trouvé dans cette Wilaya.</p></div>`;
                return;
            }

            filtered.forEach(p => {
                const isPharm = p.type === 'pharmacie';
                const card = document.createElement('div');
                card.className = "bg-white p-4 rounded-2xl shadow-sm border border-slate-200 hover:border-teal-500 transition cursor-pointer group text-start";
                card.onclick = () => {
                    if (currentMapEngine === 'gmap') updateGmapView(p.lat, p.lng, p.name);
                    else if (leafletMap) leafletMap.flyTo([p.lat, p.lng], 16);
                    document.getElementById('map-status').innerHTML = `<i class="fa-solid fa-location-dot text-teal-600 mx-1.5"></i> <strong>${p.name}</strong> - ${p.adresse}`;
                };

                card.innerHTML = `
                    <div class="flex items-start justify-between">
                        <div class="flex items-start space-x-3 rtl:space-x-reverse">
                            <div class="w-10 h-10 ${isPharm ? 'bg-emerald-600' : 'bg-blue-600'} text-white rounded-xl flex items-center justify-center shrink-0 shadow-sm mt-0.5">
                                <i class="fa-solid ${isPharm ? 'fa-prescription-bottle-medical' : 'fa-user-doctor'} text-sm"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-sm group-hover:text-teal-600 transition">${p.name}</h3>
                                <p class="text-xs text-gray-500 font-medium">${p.specialite}</p>
                                <p class="text-[11px] text-gray-400 mt-1 flex items-center"><i class="fa-solid fa-location-dot mx-1.5 text-teal-600"></i>${p.adresse}</p>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-1">
                            ${p.garde ? '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300 pulse-badge">De Garde 🟢</span>' : '<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">Ouvert</span>'}
                            ${p.chifa ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200">Carte Chifa</span>' : ''}
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-t flex items-center justify-between text-xs text-gray-600">
                        <a href="tel:${p.tel}" onclick="event.stopPropagation()" class="font-bold hover:text-teal-600 flex items-center"><i class="fa-solid fa-phone mx-1.5 text-teal-600"></i>${p.tel}</a>
                        <div class="flex items-center gap-1.5">
                            ${p.whatsapp ? `<a href="https://wa.me/${p.whatsapp}" target="_blank" onclick="event.stopPropagation()" class="text-emerald-600 bg-emerald-50 hover:bg-emerald-100 px-2 py-1 rounded-lg text-xs font-semibold"><i class="fa-brands fa-whatsapp"></i></a>` : ''}
                            <a href="https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}" target="_blank" onclick="event.stopPropagation()" class="text-slate-600 bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded-lg text-xs font-semibold flex items-center gap-1"><i class="fa-solid fa-diamond-turn-right text-teal-600"></i> Itinéraire</a>
                        </div>
                    </div>
                `;
                list.appendChild(card);
            });
        }

        function onWilayaChange() {
            const wCode = document.getElementById('wilaya-select').value;
            const target = wilayas58.find(w => w.code === wCode);
            if (target) {
                const label = target[currentLang] || target.fr;
                document.getElementById('map-status').innerHTML = `<i class="fa-solid fa-map-pin text-teal-600 mx-1.5"></i> Wilaya active : <strong>${label}</strong>`;
                if (currentMapEngine === 'gmap') updateGmapView(target.lat, target.lng);
                else if (leafletMap) leafletMap.flyTo([target.lat, target.lng], 13);
            }
            applyFilters();
        }

        function setTypeFilter(type) {
            activeType = type;
            ['all', 'medecin', 'pharmacie'].forEach(t => {
                const btn = document.getElementById(`pill-${t}`);
                if (t === type) btn.className = "px-3.5 py-1.5 rounded-full bg-white text-teal-900 font-bold transition shadow-sm";
                else btn.className = "px-3.5 py-1.5 rounded-full bg-teal-800/80 hover:bg-teal-700 text-white font-medium transition border border-teal-600/40";
            });
            applyFilters();
        }

        function toggleGardeFilter() {
            filterGarde = !filterGarde;
            const btn = document.getElementById('pill-garde');
            btn.classList.toggle('bg-white', filterGarde);
            btn.classList.toggle('text-teal-950', filterGarde);
            btn.classList.toggle('font-bold', filterGarde);
            applyFilters();
        }

        function toggleChifaFilter() {
            filterChifa = !filterChifa;
            const btn = document.getElementById('pill-chifa');
            btn.classList.toggle('bg-white', filterChifa);
            btn.classList.toggle('text-teal-950', filterChifa);
            btn.classList.toggle('font-bold', filterChifa);
            applyFilters();
        }

        function resetAllFilters() {
            document.getElementById('search-input').value = '';
            document.getElementById('wilaya-select').value = "16";
            activeType = 'all';
            filterGarde = false;
            filterChifa = false;
            setTypeFilter('all');
            onWilayaChange();
        }

        function locateUserGPS() {
            if (!("geolocation" in navigator)) { alert("GPS non supporté."); return; }
            navigator.geolocation.getCurrentPosition(pos => {
                updateGmapView(pos.coords.latitude, pos.coords.longitude, "Votre position");
                document.getElementById('map-status').innerHTML = `<i class="fa-solid fa-location-crosshairs text-blue-600 mx-1.5"></i> GPS OK`;
            }, () => alert("Veuillez autoriser l'accès GPS."));
        }

        function populateWilayas() {
            const selects = ['wilaya-select', 'new-wilaya', 'dash-wilaya'];
            selects.forEach(sId => {
                const el = document.getElementById(sId);
                if (!el) return;
                const cur = el.value || "16";
                el.innerHTML = '';
                wilayas58.forEach(w => {
                    const opt = document.createElement('option');
                    opt.value = w.code;
                    opt.textContent = w[currentLang] || w.fr;
                    if (w.code === cur) opt.selected = true;
                    el.appendChild(opt);
                });
            });
        }

        function setLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('santemap_lang', lang);
            document.documentElement.lang = lang;
            document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';

            ['fr', 'ar', 'en'].forEach(l => {
                const btn = document.getElementById(`lang-btn-${l}`);
                if (l === lang) btn.className = "px-2.5 py-1 rounded-lg bg-teal-600 text-white shadow-sm transition";
                else btn.className = "px-2 py-1 rounded-lg text-gray-600 hover:text-gray-900 transition";
            });

            populateWilayas();
            applyFilters();
        }

        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        window.addEventListener('DOMContentLoaded', () => {
            populateWilayas();
            updateAuthUI();
            setLanguage(currentLang);
        });
    </script>
</body>
</html>
